# Supabase (Story 1.3). Copy to .env and fill with your project URL and anon key.
# Do not commit .env or real keys.
# For Expo, you may use EXPO_PUBLIC_* below (or set in app.config) so the adapter can read them.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  (required for npm run db:delete-chats)
# EXPO_PUBLIC_EAS_PROJECT_ID=  (recommended for push: UUID from `eas project:info` or app.json extra.eas.projectId)
# Note: Remote push does not work in Expo Go on Android (SDK 53+). Use a dev build to test pushes on Android.

# Cloudinary (optional) — transcodes uploaded video so browsers can play it.
# Phone cameras record HEVC, which browsers cannot decode: the video plays its
# audio and shows a black rectangle. With these set, video is uploaded to
# Cloudinary and served re-encoded, with a poster frame. Leave blank to keep
# uploading originals to Supabase Storage.
# Both values are public: create an UNSIGNED upload preset so no secret is needed.
# Cloudinary console -> Settings -> Upload -> Upload presets -> Add, mode: Unsigned.
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
